{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all",
    "schedule:weekly"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "packageRules": [
    {
      "matchManagers": ["pip_requirements"],
      "rangeStrategy": "bump"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update CLI tool versions in install scripts",
      "managerFilePatterns": [
        "/^productization-plugin/tools/.+/install\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?\\n[A-Z_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?:v|jq-)?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update system package versions via repology",
      "managerFilePatterns": [
        "/^productization-plugin/tools/.+/install\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s+versioning=(?<versioning>[^\\s]+)\\n[A-Z_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^(?:\\d+:)?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)"
    },
    {
      "customType": "regex",
      "description": "Update tkn x86_64 release asset and checksum",
      "managerFilePatterns": [
        "/^productization-plugin/tools/.+/install\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=github-release-attachments\\s+depName=(?<depName>[^\\s]+)\\nTKN_X86_64_URL=\"https://github\\.com/tektoncd/cli/releases/download/v(?<currentValue>[^/]+)/(?<assetName>[^\"]+)\"\\nTKN_X86_64_SHA256=\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "currentValueTemplate": "v{{{currentValue}}}",
      "autoReplaceStringTemplate": "# renovate: datasource=github-release-attachments depName={{depName}}\nTKN_X86_64_URL=\"https://github.com/tektoncd/cli/releases/download/{{{newValue}}}/tkn_{{{replace \"v\" \"\" newValue}}}_Linux_x86_64.tar.gz\"\nTKN_X86_64_SHA256=\"{{{newDigest}}}\"",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update tkn aarch64 release asset and checksum",
      "managerFilePatterns": [
        "/^productization-plugin/tools/tkn/install\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=github-release-attachments\\s+depName=(?<depName>[^\\s]+)\\nTKN_AARCH64_URL=\"https://github\\.com/tektoncd/cli/releases/download/v(?<currentValue>[^/]+)/(?<assetName>[^\"]+)\"\\nTKN_AARCH64_SHA256=\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "currentValueTemplate": "v{{{currentValue}}}",
      "autoReplaceStringTemplate": "# renovate: datasource=github-release-attachments depName={{depName}}\nTKN_AARCH64_URL=\"https://github.com/tektoncd/cli/releases/download/{{{newValue}}}/tkn_{{{replace \"v\" \"\" newValue}}}_Linux_aarch64.tar.gz\"\nTKN_AARCH64_SHA256=\"{{{newDigest}}}\"",
      "versioningTemplate": "semver"
    }
  ]
}
